MANIFEST

# Explicit whitelist: ensure frontend library code is NEVER ignored
!frontend/src/lib/
!frontend/src/lib/**

# Backend runtime data & uploads
backend/data/uploads/*
backend/data/results/*
!backend/data/uploads/.gitkeep
!backend/data/results/.gitkeep

# Large ML model checkpoints (>100MB exceeds GitHub push limit)
# Note: Use Git LFS (git lfs track "*.pt") if you want to push weights to GitHub
*.pt
*.pth
*.safetensors
*.bin
*.onnx

# Environment & Credentials
.env
.env.local
.env.*.local
*.pem
*.key

